FROM node:22.20.0-bookworm-slim AS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends g++ make python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1
WORKDIR /app
# Keep dependencies in a reusable layer across ordinary product revisions.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/frontend/package.json apps/frontend/package.json
COPY apps/frontend/scripts/fetch-gtm.mjs apps/frontend/scripts/fetch-gtm.mjs
COPY apps/orchestrator/package.json apps/orchestrator/package.json
COPY apps/commands/package.json apps/commands/package.json
COPY apps/extension/package.json apps/extension/package.json
COPY apps/sdk/package.json apps/sdk/package.json
COPY libraries/nestjs-libraries/src/database/prisma/schema.prisma libraries/nestjs-libraries/src/database/prisma/schema.prisma
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
COPY . /app
RUN pnpm exec prisma migrate diff --from-empty --to-schema-datamodel libraries/nestjs-libraries/src/database/prisma/schema.prisma --script --output rssd/postiz-schema.sql
RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm run build
RUN node -e "for(const n of ['body-parsers','store','publisher','media','migration','editorial','editorial-actions'])require('./apps/backend/dist/rssd/'+n+'.cjs')"
# Build caches are not runtime inputs; source stays available at the pinned
# public repository revision identified by the OCI label.
RUN rm -rf apps/frontend/.next/cache apps/frontend/.next/build

FROM node:22.20.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends nginx ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system www && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
    && mkdir -p /www /config/rssd /uploads && chown -R www:www /www /var/lib/nginx
RUN npm --no-update-notifier --no-fund --global install pm2@7.0.4
WORKDIR /app
COPY --from=dependencies /app/node_modules /app/node_modules
COPY --from=build /app/apps/backend/dist /app/apps/backend/dist
COPY --from=build /app/apps/orchestrator/dist /app/apps/orchestrator/dist
COPY --from=build /app/apps/frontend/.next /app/apps/frontend/.next
COPY --from=build /app/apps/frontend/public /app/apps/frontend/public
COPY --from=build /app/apps/frontend/package.json /app/apps/frontend/next.config.js /app/apps/frontend/
COPY --from=build /app/rssd /app/rssd
COPY --from=build /app/LICENSE /app/package.json /app/
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
ENV NODE_ENV=production RSSD_DISPATCH_ENABLED=0
ARG RSSD_REVISION
LABEL org.opencontainers.image.source="https://github.com/scholay-rssd/rssd-center" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.revision=$RSSD_REVISION
EXPOSE 5000
CMD ["sh", "rssd/start-center.sh"]
