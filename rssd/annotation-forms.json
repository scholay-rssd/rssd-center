 "sections": [
  {
   "id": "article-facts",
   "title": "事实与来源",
   "appliesTo": {
    "workTypes": [
     "article"
    ]
   },
   "items": [
    {
     "id": "fact-spot-check",
     "type": "check",
     "text": "任选正文里一处具体事实（数字、日期、名称、结论），能在文末列出的来源里找到依据。",
     "note": true
    },
    {
     "id": "unsupported-claims",
     "type": "choice",
     "text": "正文里有没有读起来没有依据的断言？",
     "options": [
      {
       "id": "none",
       "label": "没有"
      },
      {
       "id": "few",
       "label": "有一两处"
      },
      {
       "id": "many",
       "label": "有多处"
      }
     ]
    },
    {
     "id": "references-match",
     "type": "check",
     "text": "文末参考来源与正文引用对得上：没有只列不引的，也没有引了却没列的。"
    }
   ]
  },
  {
   "id": "article-answer",
   "title": "是否回答了问题",
   "appliesTo": {
    "workTypes": [
     "article"
    ]
   },
   "items": [
    {
     "id": "question-answered",
     "type": "scale",
     "text": "读完之后，标题提出的问题得到了回答。",
