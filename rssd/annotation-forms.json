      "1": "完全没有回答",
      "3": "回答了一部分",
      "5": "完整回答"
     }
    },
    {
     "id": "title-fit",
     "type": "choice",
     "text": "标题和内容的关系是：",
     "options": [
      {
       "id": "accurate",
       "label": "准确概括了内容"
      },
      {
       "id": "too-broad",
       "label": "标题比内容大或泛"
      },
      {
       "id": "mismatch",
       "label": "标题与内容不符"
      },
      {
       "id": "two-part",
       "label": "标题分成了两截（前半点题、后半解释）"
      }
     ]
    },
    {
     "id": "density",
     "type": "scale",
     "text": "信息密度。",
     "anchors": {
      "1": "大量空话和套话",
      "3": "有内容但注水",
      "5": "每一段都有新信息"
     }
    }
   ]
  },
  {
